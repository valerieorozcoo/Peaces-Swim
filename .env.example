# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Your store's myshopify domain (Shopify admin → Settings → Domains)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# From the Shopify Dev Dashboard app → Settings (Client ID + Secret)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Only if you already have an older custom app with an Admin API token (shpat_...)
# SHOPIFY_ADMIN_TOKEN=

# Optional
# SHOPIFY_API_VERSION=2026-07
# SHOP_CURRENCY=USD
# ORDER_SIGNING_SECRET=any-long-random-string
# ALLOWED_ORIGIN=https://your-site.vercel.app
